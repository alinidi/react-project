{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "baseUrl": "src",
    "paths": {
      "app/*": [
        "app/*"
      ],
      "API/*": [
        "API/*"
      ],
      "common/*": [
        "common/*"
      ],
      "helper/*": [
        "helper/*"
      ],
      "components/*": [
        "components/*"
      ],
      "types/*": [
        "types/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "./dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
